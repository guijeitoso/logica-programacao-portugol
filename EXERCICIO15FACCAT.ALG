Algoritmo "exercicio15faccat"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costa dos Santos
// Descrição   : Ler um valor e escrever se é positivo ou negativo
// (considere o valor zero como positivo).  (função)
// Autor(a)    : Guilherme Souza Andrade
// Data atual  : 9/13/2026
Var
   // Seção de Declarações das variáveis
   numero: real


Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("PROGRAMA POSITIVO OU NEGATIVO")
   Escreval("")
   Escreval("")
   Escreval("DIGITE UM NUMERO: ")
   leia(numero)
   Escreval("")
   se (numero >= 0) entao
      Escreval(numero:4:2)
      Escreval("ESSE NUMERO E POSITIVO")
   senao
      Escreval(numero:4:2)
      Escreval("ESSE NUMERO E NEGATIVO")
   fimse


Fimalgoritmo
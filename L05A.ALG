Algoritmo "l05a"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costa dos Santos
// Descrição   : Apresentar os quadrados dos números inteiros de
// 15 a 200. (função)
// Autor(a)    : Guilherme Souza Andrade
// Data atual  : 9/27/2026
Var
   // Seção de Declarações das variáveis
   valor01, quadrado: inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...

   para valor01 de 15 ate 200 faca
      quadrado <- valor01 *valor01
      Escreval("O resultado do valor ao quadrado é: ", quadrado)
   fimpara
   
Fimalgoritmo
Algoritmo "exercico19"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas dos Santos
// Descrição   : Ler dois valores (considere que não serão lidos
// valores iguais) e escrever o maior deles.  (função)
// Autor(a)    : Guilherme Souza Andrade
// Data atual  : 9/13/2026
Var
   // Seção de Declarações das variáveis
   x, y: inteiro


Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("****** PROGRAMA DOIS VALORES******")
   Escreval("")
   Escreval("")
   Escreva("DIGITE O PRIMEIRO NUMERO: ")
   leia(x)
   Escreval("")
   Escreva("DIGITE UM SEGUNDO NUMERO: ")
   leia(y)
   Escreval("")
   limpatela
   se (x > y)  entao
      Escreval("O MAIOR NUMERO E: ",x)
   senao
      Escreval("O MAIOR NUMERO E: ",y)
   fimse
Fimalgoritmo